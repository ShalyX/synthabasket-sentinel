# Optional Binance Web3 API credentials. Keep actual values in .env.local only.
# Never commit credentials or expose wallet sessions in public application code.
OC_API_KEY=
OC_SECRET_KEY=

# DANGEROUS: live BSC wallet spending is OFF by default.
# Do not enable until contracts, function selectors, routing behavior, eligibility and QA are independently reviewed.
SENTINEL_LIVE_EXECUTION_ENABLED=false
SENTINEL_ALLOWED_SWAP_TARGETS=
SENTINEL_ALLOWED_APPROVAL_SPENDERS=
SENTINEL_ALLOWED_SWAP_SELECTORS=
