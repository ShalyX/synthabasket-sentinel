# Optional Binance Web3 API credentials. Keep actual values in .env.local only.
# Never commit credentials or expose wallet sessions in public application code.
OC_API_KEY=
OC_SECRET_KEY=

# DANGEROUS: direct browser-wallet spending is OFF by default. Enabling this
# accepts authenticated Binance-built calldata as a provider trust boundary;
# nested LiquidMesh calls are structurally pinned but not independently decoded.
# The UI also requires fresh user eligibility and route-trust attestations.
SENTINEL_LIVE_EXECUTION_ENABLED=false
SENTINEL_ALLOWED_SWAP_TARGETS=0xb44446b0c8e56988c34f7ff73ae904982b5fdda5
SENTINEL_ALLOWED_APPROVAL_SPENDERS=0xb44446b0c8e56988c34f7ff73ae904982b5fdda5
SENTINEL_ALLOWED_SWAP_SELECTORS=0xad43f73d
